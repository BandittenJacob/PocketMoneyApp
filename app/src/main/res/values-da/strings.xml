    <!-- Spotlight Tours -->
    <string name="tour_chores_library_title">Opgavebibliotek &#128218;</string>
    <string name="tour_chores_library_body">Tryk her for at åbne dine opgaveskabeloner. Udrul en skabelon med ét tryk for at oprette en færdig opgave.</string>
    <string name="tour_chores_history_title">Opgavehistorik &#128336;</string>
    <string name="tour_chores_history_body">Tryk her for at se godkendte og betalte opgaver. Forældre kan også sende en opgave tilbage til afventende herfra.</string>
    <string name="tour_chores_reorder_title">Omarranger opgaver</string>
    <string name="tour_chores_reorder_body">Tryk her for at aktivere omarrangeringstilstand. Træk håndtagene på hvert opgavekort for at omarrangere dem. Tryk på fluebenet når du er færdig.</string>
    <string name="tour_chores_suggest_title">Foreslå en opgave &#128161;</string>
    <string name="tour_chores_suggest_body">Har du en idé til en opgave? Tryk her for at foreslå den til dine forældre. Du kan angive navn, beskrivelse og en foreslået belønning.</string>
    <string name="tour_chores_card_title">Opgavekort</string>
    <string name="tour_chores_card_body">Tryk på et opgavekort for at udvide det og se alle detaljer. Hold fingeren nede for direkte at gå til redigering.</string>    <string name="tour_chores_fab_title">Tilf&#248;j en opgave &#10133;</string>
    <string name="tour_chores_fab_body">Tryk her for at tilf&#248;je en ny opgave. Giv den et navn, beskrivelse og en bel&#248;nning — og tildel den evt. til et familiemedlem.</string>

    <!-- Dashboard-tur -->
    <string name="tour_dashboard_chores_title">Opgaver 📝</string>
    <string name="tour_dashboard_chores_body_parent">Tryk for at administrere og tildele opgaver til din familie. S&#230;t bel&#248;nninger, f&#248;lg fremskridt og godkend udf&#248;rt arbejde.</string>
    <string name="tour_dashboard_chores_body_child">Tryk for at se dine opgaver og markere dem som udf&#248;rte. Lav opgaver for at tjene lommepenge!</string>
    <string name="tour_dashboard_members_title">Familiemedlemmer 👨‍👩‍👧‍👦</string>
    <string name="tour_dashboard_members_body_parent">Tryk for at se alle familiemedlemmer og deres lommepenge-saldo. Tilf&#248;j transaktioner og administr&#233;r lommepenge her.</string>
    <string name="tour_dashboard_members_body_child">Tryk for at se din lommepenge-saldo og resten af din familie.</string>
    <string name="tour_dashboard_settings_title">Indstillinger &#9881;</string>
    <string name="tour_dashboard_settings_body">Skift appens sprog, ops&#230;t en pinkode, aktiver biometrisk login og administr&#233;r din familie her.</string>

    <!-- Opgavebibliotek-tur -->
    <string name="tour_library_card_title">Opgaveskabeloner 📋</string>
    <string name="tour_library_card_body">Hvert kort er en gemt opgaveskabelon. Tryk p&#229; &#9654;-knappen for straks at oprette en opgave fra den, eller blyanten for at redigere den.</string>
    <string name="tour_library_fab_title">Ny skabelon &#10133;</string>
    <string name="tour_library_fab_body">Tryk her for at oprette en ny opgaveskabelon. Giv den et navn, beskrivelse, en standardbel&#248;nning og tildel den evt. til et familiemedlem.</string>

    <!-- Familiemedlemmer-tur -->
    <string name="tour_family_members_money_title">Tilf&#248;j transaktion 💰</string>
    <string name="tour_family_members_money_body">Tryk her for at tilf&#248;je en transaktion til et familiemedlem — en bonus, en korrektion eller en bankoverf&#248;rsel. S&#229;dan justerer du hvert barns saldo.</string>

    <!-- Indstillinger-tur -->
    <string name="tour_settings_language_title">App-sprog 🌐</string>
    <string name="tour_settings_language_body">Skift mellem engelsk og dansk. Appen genstarter straks for at anvende &#230;ndringen.</string>
    <string name="tour_settings_biometric_title">Biometrisk login 👆</string>
    <string name="tour_settings_biometric_body">Aktiver fingeraftryk eller ansigtsoplusning, s&#229; du ikke beh&#248;ver at indtaste din pinkode, hver gang du &#229;bner appen.</string>
    <string name="tour_settings_pin_title">Skift pinkode 🔒</string>
    <string name="tour_settings_pin_body">Skift din 4-cifrede login-pinkode her. Du bliver bedt om at indtaste den nye pinkode to gange for at bekr&#230;fte.</string>
    <string name="tour_settings_proposals_title">Opgaveforslag 💡</string>
    <string name="tour_settings_proposals_body">N&#229;r aktiveret, kan b&#248;rn foresl&#229; nye opgaver fra opgavesk&#230;rmen. Du kan derefter acceptere, redigere eller afvise deres forslag.</string>
    <string name="tour_settings_danger_title">Farezonen &#9888;</string>
    <string name="tour_settings_danger_body">Slet din familie og alle dens data her. Dette kr&#230;ver godkendelse fra alle for&#230;ldre og kan ikke fortrydes.</string></resources>
