    <!-- Spotlight Tours -->
    <string name="tour_chores_library_title">Chore Library &#128218;</string>
    <string name="tour_chores_library_body">Tap here to open your chore templates. Deploy any template with one tap to create a ready-made chore.</string>
    <string name="tour_chores_history_title">Chore History &#128336;</string>
    <string name="tour_chores_history_body">Tap here to see approved and paid chores. Parents can also revert a chore back to pending from here.</string>
    <string name="tour_chores_reorder_title">Reorder Chores</string>
    <string name="tour_chores_reorder_body">Tap here to enter reorder mode. Drag the handles on each chore card to rearrange them. Tap the checkmark when done.</string>
    <string name="tour_chores_suggest_title">Suggest a Chore &#128161;</string>
    <string name="tour_chores_suggest_body">Got an idea for a chore? Tap here to suggest it to your parents. You can include a name, description, and a suggested reward.</string>
    <string name="tour_chores_card_title">Chore Cards</string>
    <string name="tour_chores_card_body">Tap a chore card to expand it and see full details. Long-press to jump straight to editing.</string>
    <string name="tour_chores_fab_title">Add a Chore &#10133;</string>
    <string name="tour_chores_fab_body">Tap here to add a new chore. Give it a name, description, and a reward value — and optionally assign it to a family member.</string>

    <!-- Dashboard tour -->
    <string name="tour_dashboard_chores_title">Chores 📝</string>
    <string name="tour_dashboard_chores_body_parent">Tap to manage and assign chores for your family. Set rewards, track progress, and approve completed work.</string>
    <string name="tour_dashboard_chores_body_child">Tap to see your tasks and mark them done. Complete chores to earn pocket money!</string>
    <string name="tour_dashboard_members_title">Family Members 👨‍👩‍👧‍👦</string>
    <string name="tour_dashboard_members_body_parent">Tap to see all family members and their pocket money balances. Add transactions and manage allowances here.</string>
    <string name="tour_dashboard_members_body_child">Tap to see your pocket money balance and the rest of your family.</string>
    <string name="tour_dashboard_settings_title">Settings &#9881;</string>
    <string name="tour_dashboard_settings_body">Change the app language, set up a PIN, enable biometric login, and manage your family here.</string>

    <!-- Chore Library tour -->
    <string name="tour_library_card_title">Chore Templates 📋</string>
    <string name="tour_library_card_body">Each card is a saved chore template. Tap the &#9654; button to instantly create a chore from it, or the pencil icon to edit it.</string>
    <string name="tour_library_fab_title">New Template &#10133;</string>
    <string name="tour_library_fab_body">Tap here to create a new chore template. Give it a name, description, a default reward, and optionally assign it to a family member.</string>

    <!-- Family members tour -->
    <string name="tour_family_members_money_title">Add Transaction 💰</string>
    <string name="tour_family_members_money_body">Tap here to add a transaction for a family member — a bonus, a correction, or a bank transfer. This is how you adjust each child\'s balance.</string>

    <!-- Settings tour -->
    <string name="tour_settings_language_title">App Language 🌐</string>
    <string name="tour_settings_language_body">Switch between English and Danish. The app will restart immediately to apply the change.</string>
    <string name="tour_settings_biometric_title">Biometric Login 👆</string>
    <string name="tour_settings_biometric_body">Enable fingerprint or face unlock so you don\'t have to enter your PIN every time you open the app.</string>
    <string name="tour_settings_pin_title">Change PIN 🔒</string>
    <string name="tour_settings_pin_body">Change your 4-digit login PIN here. You\'ll be asked to enter the new PIN twice to confirm.</string>
    <string name="tour_settings_proposals_title">Chore Proposals 💡</string>
    <string name="tour_settings_proposals_body">When enabled, children can suggest new chores from the chores screen. You can then accept, edit, or reject their suggestions.</string>
    <string name="tour_settings_danger_title">Danger Zone &#9888;</string>
    <string name="tour_settings_danger_body">Delete your family and all its data here. This requires all parents to approve and cannot be undone.</string>
</resources>
