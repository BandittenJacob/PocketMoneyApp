{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug APK",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["assembleDebug"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Install on Device",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["installDebug"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Build and Install",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["installDebug"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": ".\\gradlew.bat",
      "args": ["clean"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "List Connected Devices",
      "type": "shell",
      "command": "adb",
      "args": ["devices"],
      "problemMatcher": []
    },
    {
      "label": "Release to Firebase (Familien)",
      "type": "shell",
      "command": "powershell",
      "args": ["-ExecutionPolicy", "Bypass", "-File", ".\\scripts\\release-firebase.ps1"],
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
